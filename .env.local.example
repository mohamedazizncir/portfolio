# Copy this file to .env.local and fill in real values. .env.local is gitignored.

# Google Gemini API key. Get one at https://aistudio.google.com/apikey
# Used for both chat generation and knowledge base embeddings (lib/rag/embed.ts),
# so this is required regardless of which LLM_PROVIDER you select for chat.
GEMINI_API_KEY=

# Optional: overrides the default Gemini model (gemini-3.5-flash-lite).
# GEMINI_MODEL=gemini-3.5-flash-lite

# Groq API key. Only needed if LLM_PROVIDER=groq. Get one at https://console.groq.com/keys
# GROQ_API_KEY=

# Optional: overrides the default Groq model (llama-3.3-70b-versatile).
# GROQ_MODEL=llama-3.3-70b-versatile

# Optional: selects the LLM provider implementation (see lib/llm/provider.ts).
# "gemini" (default) or "groq".
# LLM_PROVIDER=gemini
