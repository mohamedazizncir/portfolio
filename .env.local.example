# Copy this file to .env.local and fill in real values. .env.local is gitignored.

# Google Gemini API key. Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional: overrides the default Gemini model (gemini-2.5-flash-lite).
# GEMINI_MODEL=gemini-2.5-flash-lite

# Optional: selects the LLM provider implementation (see lib/llm/provider.ts).
# Only "gemini" exists in Phase 1.
# LLM_PROVIDER=gemini
